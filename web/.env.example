# Copiar a .env.local para desarrollo. No poner secretos aquí.

# URL del backend Go al que next.config.js reenvía /api/* (local o Cloud Run, sin barra final)
BACKEND_URL=http://localhost:8080

# Base usada por lib/api.ts en el navegador. Debe seguir siendo relativa para mantener same-origin.
NEXT_PUBLIC_API_URL=/api/v1

# Clave de sitio PÚBLICA de reCAPTCHA Enterprise (la API key va solo en el backend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
