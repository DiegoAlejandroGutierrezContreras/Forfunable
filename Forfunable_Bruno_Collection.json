      "item": [
        {
          "name": "1.1 Registro de Usuario (POST /auth/register)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nuevo_dev\",\n  \"email\": \"nuevo_dev@forfunable.com\",\n  \"password\": \"Password123!\",\n  \"recaptcha_token\": \"mock_token_pass\"\n}"
