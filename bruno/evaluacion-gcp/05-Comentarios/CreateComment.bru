meta {
  name: CreateComment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/comments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..rnNHg99t1wN5XrX8xW9GdehjXVCzQ6rkGYLFqNO8xYc
}

body:json {
  {
    "post_id": "492ebcbe-9448-47ea-ba2a-348211c15de0",
    "content": "comentario prueba de prueba"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.content: eq Comentario raíz insertado con ltree en Cloud SQL
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("commentId", res.body.id);
  }
}
