meta {
  name: CreateComment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "post_id": "{{postId}}",
    "content": "Comentario raíz insertado con ltree en Cloud SQL"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.content: eq Comentario raíz insertado con ltree en Cloud SQL
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("commentId", res.body.id);
  }
}
