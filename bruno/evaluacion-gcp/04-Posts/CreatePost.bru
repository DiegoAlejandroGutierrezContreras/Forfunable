meta {
  name: CreatePost
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/posts
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..rnNHg99t1wN5XrX8xW9GdehjXVCzQ6rkGYLFqNO8xYc
}

body:json {
  {
    "community_id": "264af240-064c-448c-b4eb-8b23636aa90d",
    "title": "prueba dentro de la prueba",
    "content_type": "TEXT",
    "body_text": "prueba ultima."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.title: eq Prueba de Persistencia en Cloud SQL
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("postId", res.body.id);
  }
}
