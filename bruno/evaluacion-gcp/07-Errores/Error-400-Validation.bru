meta {
  name: Error-400-Validation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "x",
    "email": "correo-invalido",
    "password": "123"
  }
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}
