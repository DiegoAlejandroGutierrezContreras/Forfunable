meta {
  name: UpdateProfile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/users/me/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "bio": "Perfil actualizado en Google Cloud Platform - Persistencia verificada"
  }
}

assert {
  res.status: eq 200
  res.body.bio: eq Perfil actualizado en Google Cloud Platform - Persistencia verificada
}
