# ==============================================================================
# Variables de entorno para Forfunable API
# ==============================================================================

# Entorno y servidor
PORT=8080
ENVIRONMENT=production
GIN_MODE=release

# Seguridad JWT (Almacenar en Google Secret Manager para producción)
JWT_SECRET=reemplazar_con_secreto_generado_de_minimo_32_caracteres_aleatorios

# Conexión a Base de Datos - OPCIÓN 1: Socket Unix (Recomendado para Google Cloud Run)
INSTANCE_CONNECTION_NAME=tu-proyecto-gcp:region-gcp:nombre-instancia-sql
DB_USER=forfunable_user
DB_PASSWORD=reemplazar_con_password_segura_de_cloud_sql
DB_NAME=forfunable_db

# Conexión a Base de Datos - OPCIÓN 2: URL Estándar TCP (Para desarrollo local o proxy)
# DATABASE_URL=postgres://forfunable_user:password_segura@127.0.0.1:5432/forfunable_db?sslmode=disable

# reCAPTCHA Enterprise (Account Defender) - Login, Registro y Creación de Comunidad
# true omite la verificación (solo desarrollo local). En producción usar false.
RECAPTCHA_BYPASS=true
RECAPTCHA_PROJECT_ID=tu-proyecto-gcp
RECAPTCHA_SITE_KEY=reemplazar_con_site_key_publica
# Almacenar en Google Secret Manager para producción
RECAPTCHA_API_KEY=reemplazar_con_api_key_de_recaptcha
RECAPTCHA_MIN_SCORE=0.5
